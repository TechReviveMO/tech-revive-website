const form = document.getElementById('repair-form');
const preview = document.getElementById('request-preview');
const messageBox = document.getElementById('request-message');
const status = document.getElementById('form-status');
const textLink = document.getElementById('text-request');
form.addEventListener('submit', function(e) {
  e.preventDefault();
  for (const id of ['name','model']) {
    const field = document.getElementById(id);
    field.value = field.value.trim();
  }
  if (!form.reportValidity()) return;
  const v = id => document.getElementById(id).value.trim();
  messageBox.value = ["Hi Tech Revive! I'd like a repair quote.", 'Name: '+v('name'), 'Phone: '+v('model'), 'Repair: '+v('repair'), 'Estimate: '+(repairEstimate()?.price != null ? 'From $'+repairEstimate().price+' installed; final quote pending' : 'Quote required'), 'Issue: '+(v('issue') || 'Not specified'), 'Best time: '+v('time'), 'Service preference: '+v('service')].join('\n');
  textLink.href = 'sms:+18163483989?body='+encodeURIComponent(messageBox.value);
  preview.hidden = false;
  status.textContent = 'Request prepared, not sent. Choose Open text message or Copy request below.';
  messageBox.focus();
});
form.addEventListener('input', function(e) {
  if (e.target === messageBox) return;
  preview.hidden = true;
  status.textContent = 'Details changed. Select Review my request to prepare your updated message.';
});
textLink.addEventListener('click', function() {
  status.textContent = 'Your messaging app may open. Review the message & press Send there. If no app opens, copy the request or call (816) 348-3989. Nothing has been sent by this website.';
});
document.getElementById('copy-request').addEventListener('click', async function() {
  try {
    await navigator.clipboard.writeText(messageBox.value);
    status.textContent = 'Copied, not sent. Paste into your messaging app & send to (816) 348-3989.';
  } catch (error) {
    messageBox.focus();
    messageBox.select();
    status.textContent = 'Automatic copying is unavailable. Your message is selected: press Ctrl+C (Windows), Command+C (Mac), or touch & hold to copy. Then send it to (816) 348-3989.';
  }
});
